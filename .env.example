# ---------------------------------------------------------------------------
# FitCoach environment. Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# --- LLM: DeepSeek, called through the OpenAI SDK -------------------------
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model IDs are configuration, not code, so a provider rename is a one-line fix.
# Verify current IDs at https://api-docs.deepseek.com/quick_start/pricing
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_STRONG=deepseek-v4-pro

# --- MongoDB --------------------------------------------------------------
# Local server: mongodb://localhost:27017
# Atlas: get the SRV string from Atlas > Connect > Drivers
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fitcoach

# --- Email: Gmail SMTP with an App Password --------------------------------
# Create at https://myaccount.google.com/apppasswords (needs 2FA enabled).
# This is NOT your Gmail login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=FitCoach <you@gmail.com>

# --- Secrets: generate with `python -c "import secrets;print(secrets.token_urlsafe(48))"`
# Signs user-facing JWT access and refresh tokens.
JWT_SECRET=change-me-long-random-value
# HMAC key for the inter-agent envelope signature. Every service shares it.
AGENT_SHARED_SECRET=change-me-different-long-random-value

# --- Vector store ---------------------------------------------------------
CHROMA_PATH=./chroma_data

# --- Service URLs (docker compose overrides these with service names) ------
GATEWAY_URL=http://localhost:8000
AGENT1_URL=http://localhost:8001
AGENT2_URL=http://localhost:8002
AGENT3_URL=http://localhost:8003

# --- Web client -----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Runtime --------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Cost controls: local rules + semantic detection always remain active.
LLM_FALLBACK_ENABLED=true
LLM_JUDGE_ENABLED=false
LLM_MAX_OUTPUT_TOKENS=350
